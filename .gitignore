# Rust
target/
# `vendor/` is generally ignored, but we keep vendor/zeromq/ under
# version control because it's a patched fork of zeromq-rs 0.4.1 pulled
# in via `[patch.crates-io]` in Cargo.toml to fix the upstream silent
# large-message drop in `PubSocket::send` (see epic-13 live-deploy retro
# §G8). Must be committed so clean clones reproduce the patched build.
vendor/*
!vendor/zeromq/
vendor/zeromq/target/
# Note: Cargo.lock is committed — shipped binary project (KR-02)

# Node / Docs
docs/node_modules/
docs/dist/
docs/.astro/

# Wheelhouse runtime
.wheelhouse/
*.wh.lock

# Python SDK generated proto files (FP-02)
# The top-level _proto/__init__.py stub is excluded, but the versioned sub-package
# (wheelhouse/v1/__init__.py) is committed so Docker builds work without grpcio-tools.
# Regenerate with: cd sdk/python && make proto-python
sdk/python/wheelhouse/_proto/__init__.py
!sdk/python/wheelhouse/_proto/wheelhouse/
sdk/python/.venv/
agent-claude/.venv/
.venv/
sdk/python/.pytest_cache/
__pycache__/
*.pyc

# Secrets
.env
.env.*
*.token
secrets/

# macOS
.DS_Store

# Editor
.idea/
.vscode/
.cursor
.windsurf
*.swp

# BMAD / AI tooling
_bmad
_bmad-output
.claude
